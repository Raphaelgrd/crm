rules_version = '2';

// Projet crm-netforce. Seules les sessions ouvertes par le serveur du CRM
// (/api/auth/crm-token, jeton portant crm: true) peuvent lire ou écrire.
service cloud.firestore {
  match /databases/{database}/documents {
    // Tout le CRM : membres de l'équipe connectés, sauf les tâches privées du Siège IA.
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.crm == true
        && collection != 'siegeTasksPrivate';
    }
    // Tâches privées du Siège IA : admins seulement.
    match /siegeTasksPrivate/{task} {
      allow read, write: if request.auth != null && request.auth.token.crm == true
        && request.auth.token.admin == true;
    }
  }
}
